# Store the real file at /etc/task-agent/agent.env with mode 600; never commit it.
TASK_AGENT_RESOURCE=https://tasks.example.com/mcp
TASK_AGENT_ISSUER=https://cognito-idp.REGION.amazonaws.com/POOL_ID
TASK_AGENT_JWKS_URI=https://cognito-idp.REGION.amazonaws.com/POOL_ID/.well-known/jwks.json
TASK_AGENT_OWNER_SUBJECT=EXACT_COGNITO_SUB_NOT_EMAIL
TASK_AGENT_CLIENT_IDS=CHATGPT_CLIENT_ID,CLAUDE_CLIENT_ID,WORK_CLIENT_ID
TASK_AGENT_READ_SCOPE=https://tasks.example.com/mcp/read
TASK_AGENT_WRITE_SCOPE=https://tasks.example.com/mcp/write
TASK_AGENT_REVOKED_BEFORE=0
# Never put AWS keys or OAuth client secrets in this file.
